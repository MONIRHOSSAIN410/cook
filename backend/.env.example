NODE_ENV=development
PORT=5000

# Local MongoDB — for developing on your own machine:
#   MONGO_URI="mongodb://127.0.0.1:27017/cookme"
#
# MongoDB Atlas — required for the site deployed on Vercel, since Vercel's
# servers cannot reach a database on your own computer. Copy the connection
# string from Atlas → Connect → Drivers. It must start with mongodb+srv://
#   MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cookmy?retryWrites=true&w=majority"
MONGO_URI="mongodb+srv://akmmonir304_db_user:7qorUkF31KfVUttJ@cluster0.7rxuzns.mongodb.net/cook?appName=Cluster0"

JWT_SECRET="cookme_super_secret_change_me"
JWT_EXPIRES_IN=30d

# One or more frontend origins, comma-separated. "*.vercel.app" covers every
# Vercel preview deployment of the frontend, not just production.
CLIENT_URL="https://cook-bice.vercel.app/"
